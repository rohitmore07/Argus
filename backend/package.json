{
  "name": "pr-sentinel-backend",
  "version": "1.0.0",
  "private": true,
  "description": "PR Sentinel Express.js + TypeScript + MongoDB + BullMQ + Gemini AI Backend",
  "scripts": {
  "dev": "tsx watch src/server.ts",
  "start": "node dist/server.js",
  "start:worker": "node dist/worker.js",
  "build": "tsc -p tsconfig.json",
  "typecheck": "tsc --noEmit -p tsconfig.json",
  "test": "vitest run",
  "test:watch": "vitest"
  },
  "dependencies": {
    "@google/genai": "^1.52.0",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.9",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "mongodb-memory-server": "^10.1.4",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
